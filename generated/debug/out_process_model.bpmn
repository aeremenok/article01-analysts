<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_001" targetNamespace="http://bpmn.io/schema/bpmn">
  
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" name="Process" processRef="Process_1"/>
  </collaboration>
  
  <process id="Process_1" isExecutable="false">
    <laneSet id="LaneSet_1">
      <lane id="Lane_1" name="Физическое лицо (ФЛ)">
        <flowNodeRef>StartEvent_1</flowNodeRef>
        <flowNodeRef>Task_1</flowNodeRef>
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>Task_3</flowNodeRef>
        <flowNodeRef>Task_4</flowNodeRef>
        <flowNodeRef>Task_5</flowNodeRef>
        <flowNodeRef>Gateway_1</flowNodeRef>
        <flowNodeRef>Task_6</flowNodeRef>
        <flowNodeRef>EndEvent_1</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Администратор НКО">
        <flowNodeRef>Task_7</flowNodeRef>
        <flowNodeRef>Task_8</flowNodeRef>
        <flowNodeRef>Task_9</flowNodeRef>
        <flowNodeRef>Task_10</flowNodeRef>
        <flowNodeRef>EndEvent_2</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Система">
        <flowNodeRef>Task_2</flowNodeRef>
        <flowNodeRef>Gateway_1</flowNodeRef>
        <flowNodeRef>Task_6</flowNodeRef>
      </lane>
    </laneSet>
    
    <startEvent id="StartEvent_1" name="Начало процесса"/>
    
    <userTask id="Task_1" name="Регистрация нового физического лица"/>
    <serviceTask id="Task_2" name="Создание персональной папки для ФЛ"/>
    <userTask id="Task_3" name="Загрузка документов в личный кабинет"/>
    <userTask id="Task_4" name="Просмотр документов в личном кабинете"/>
    <userTask id="Task_5" name="Доступ к личному кабинету ФЛ"/>
    <exclusiveGateway id="Gateway_1" name="Проверка прав доступа к документам"/>
    <serviceTask id="Task_6" name="Создание уведомлений о новых документах"/>
    <userTask id="Task_7" name="Формирование реестра физических лиц"/>
    <userTask id="Task_8" name="Фильтрация реестров по различным атрибутам"/>
    <userTask id="Task_9" name="Сортировка реестров"/>
    <userTask id="Task_10" name="Поиск по реестрам физических лиц"/>
    
    <endEvent id="EndEvent_1" name="Конец процесса"/>
    <endEvent id="EndEvent_2" name="Конец процесса"/>
    
    <sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3"/>
    <sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_4"/>
    <sequenceFlow id="Flow_5" sourceRef="Task_3" targetRef="Task_5"/>
    <sequenceFlow id="Flow_6" sourceRef="Task_3" targetRef="Gateway_1"/>
    <sequenceFlow id="Flow_9" sourceRef="Gateway_1" targetRef="EndEvent_1">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.w3.org/1999/XPath">Права доступа разрешены</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_10" sourceRef="Gateway_1" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.w3.org/1999/XPath">Права доступа запрещены</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_11" sourceRef="Task_6" targetRef="EndEvent_2"/>
    <sequenceFlow id="Flow_7" sourceRef="Task_4" targetRef="Task_7"/>
    <sequenceFlow id="Flow_8" sourceRef="Task_5" targetRef="Task_7"/>
    <sequenceFlow id="Flow_12" sourceRef="Task_7" targetRef="Task_8"/>
    <sequenceFlow id="Flow_13" sourceRef="Task_7" targetRef="Task_9"/>
    <sequenceFlow id="Flow_14" sourceRef="Task_7" targetRef="Task_10"/>
    <sequenceFlow id="Flow_15" sourceRef="Task_8" targetRef="EndEvent_2"/>
    <sequenceFlow id="Flow_16" sourceRef="Task_9" targetRef="EndEvent_2"/>
    <sequenceFlow id="Flow_17" sourceRef="Task_10" targetRef="EndEvent_2"/>
  </process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <!-- Auto-layout: start at x=180, tasks 180px apart, lanes 150px height -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="180" y="300" width="30" height="30"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="270" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="430" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="590" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="750" y="210" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <dc:Bounds x="750" y="390" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1">
        <dc:Bounds x="910" y="300" width="50" height="50"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6">
        <dc:Bounds x="1000" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_7_di" bpmnElement="Task_7">
        <dc:Bounds x="750" y="570" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_8_di" bpmnElement="Task_8">
        <dc:Bounds x="910" y="570" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_9_di" bpmnElement="Task_9">
        <dc:Bounds x="1070" y="570" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="Task_10_di" bpmnElement="Task_10">
        <dc:Bounds x="1230" y="570" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1150" y="300" width="30" height="30"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNShape id="EndEvent_2_di" bpmnElement="EndEvent_2">
        <dc:Bounds x="1380" y="590" width="30" height="30"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="210" y="315"/>
        <di:waypoint x="270" y="340"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="370" y="340"/>
        <di:waypoint x="430" y="340"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="530" y="340"/>
        <di:waypoint x="590" y="340"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="690" y="340"/>
        <di:waypoint x="750" y="250"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="690" y="380"/>
        <di:waypoint x="750" y="430"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="690" y="340"/>
        <di:waypoint x="910" y="325"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="960" y="325"/>
        <di:waypoint x="1150" y="315"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="960" y="325"/>
        <di:waypoint x="1000" y="340"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1100" y="340"/>
        <di:waypoint x="1380" y="315"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="850" y="340"/>
        <di:waypoint x="850" y="570"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="850" y="430"/>
        <di:waypoint x="850" y="570"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="850" y="610"/>
        <di:waypoint x="910" y="610"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="850" y="610"/>
        <di:waypoint x="1070" y="610"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="850" y="610"/>
        <di:waypoint x="1230" y="610"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="1010" y="610"/>
        <di:waypoint x="1380" y="605"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="1170" y="610"/>
        <di:waypoint x="1380" y="605"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="1330" y="610"/>
        <di:waypoint x="1380" y="605"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>